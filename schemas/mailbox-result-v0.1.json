{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flop-bench.local/schemas/mailbox-result-v0.1.json",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "evidence_id",
    "verdict",
    "evidence_hash",
    "bench_did",
    "original_sender_did",
    "common_control_disclosure",
    "independent_evidence",
    "result_delivery_status",
    "phase",
    "network_action",
    "state_write",
    "will_load_private_key",
    "will_sign",
    "will_acquire_nonce",
    "will_post",
    "will_reply",
    "will_update_router",
    "urls_followed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "flop-bench.mailbox-result.v0.1"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "evidence_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "PARTIAL", "FAIL"]},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bench_did": {"type": "string", "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"},
    "original_sender_did": {
      "type": ["string", "null"],
      "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "reply_room": {"type": ["string", "null"], "maxLength": 2048},
    "common_control_disclosure": {"const": true},
    "independent_evidence": {"const": false},
    "result_delivery_status": {"const": "not_sent"},
    "phase": {"type": "string", "minLength": 1, "maxLength": 256},
    "network_action": {"const": false},
    "state_write": {"const": false},
    "will_load_private_key": {"const": false},
    "will_sign": {"const": false},
    "will_acquire_nonce": {"const": false},
    "will_post": {"const": false},
    "will_reply": {"const": false},
    "will_update_router": {"const": false},
    "urls_followed": {"const": false}
  }
}
